<?xml version="1.0" encoding="utf-8"?>
<!--
  OrSoft tanıtım sitesi — IIS ayarları.

  NİYE VAR: IIS, .html dosyalarını "Content-Type: text/html" olarak gönderiyordu,
  charset bilgisi olmadan. Tarayıcılar sayfadaki <meta charset="utf-8"> etiketini
  okuduğu için ziyaretçide sorun çıkmıyor; ama HTTP başlığına bakan tarama
  botları Türkçe karakterleri bozuk okuyabiliyor. Arama sonucundaki özet
  metninde "Reçete" yerine "ReÃ§ete" görünmesi bu yüzden olur.

  2026-10-20'de ölçüldü ve eklendi.
-->
<configuration>
  <system.webServer>
    <staticContent>
      <remove fileExtension=".html" />
      <mimeMap fileExtension=".html" mimeType="text/html; charset=utf-8" />
      <remove fileExtension=".xml" />
      <mimeMap fileExtension=".xml" mimeType="application/xml; charset=utf-8" />
      <remove fileExtension=".txt" />
      <mimeMap fileExtension=".txt" mimeType="text/plain; charset=utf-8" />
    </staticContent>
  </system.webServer>
</configuration>
